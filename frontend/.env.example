# Frontend Environment Variables Template
# Copy this file to .env and fill in your values
# Or run the deployment script: npm run deploy (backend/scripts/deploy.js)
#
# Every VITE_ variable below is read by frontend/src/api/config.ts. Vite
# inlines them at build time, so a change needs a rebuild, and none of them is
# a secret -- they ship in the bundle.

# Backend API Gateway endpoint
# This is set automatically by npm run deploy, or manually after a backend deployment
# Format: https://{api-id}.execute-api.{region}.amazonaws.com/Prod
VITE_API_ENDPOINT=https://your-api-id.execute-api.us-west-2.amazonaws.com/Prod

# Auth / Billing feature flags
# VITE_AUTH_ENABLED gates the whole signed-in UI: the header controls, the
# tier banner and the quota indicator.
#
# VITE_BILLING_ENABLED is DECLARED BUT NOT CONSUMED -- api/config.ts exports
# BILLING_ENABLED and no component reads it. Setting it changes nothing today.
VITE_AUTH_ENABLED=false
VITE_BILLING_ENABLED=false

# Cognito Hosted UI (all four required when VITE_AUTH_ENABLED=true)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:3000/

# Admin dashboard. Routes under /admin render only when this is true; the
# backend enforces the admins Cognito group regardless.
VITE_ADMIN_ENABLED=false

# CAPTCHA (Cloudflare Turnstile). The widget renders for unauthenticated
# callers when enabled. VITE_TURNSTILE_SITE_KEY is required when it is.
VITE_CAPTCHA_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Not a VITE_ variable, so it is not exposed to client code: ANALYZE=true is
# read by vite.config.ts at build time and adds the Rollup visualizer, writing
# dist/stats.html. `npm run analyze` sets it. Leave it unset for a normal
# build -- the module graph carries absolute source paths and should not be
# deployed.
# ANALYZE=true
