# Pixel Prompt v2 Deployment Configuration
# Copy this file to .env.deploy and fill in your values
# .env.deploy is gitignored and will not be committed

# AWS Configuration
AWS_REGION=us-west-2
STACK_NAME=pixel-prompt-v2

# ============================================
# REQUIRED: no default, deploy fails without it
# ============================================
# "true" or "false". There is no safe value to assume: "false" serves
# unauthenticated traffic, "true" requires Cognito and GUEST_TOKEN_SECRET.
# Gates identity only -- quota, cost caps and spend metering apply either way.
AUTH_ENABLED=false

# ============================================
# SPEND CEILINGS
# ============================================
# Hard monthly ceiling in micro-dollars. Default $500. This is the bound that
# caps the invoice; a daily ceiling alone does not.
MONTHLY_SPEND_CEILING_USD_MICROS=500000000
# Hard daily ceiling. Default $25, one twentieth of the month, so a busy day
# is not throttled while one day cannot consume the budget.
GLOBAL_DAILY_SPEND_CEILING_USD_MICROS=25000000

# Where operational alarms are delivered. Leave empty and the alarms still
# fire and appear in CloudWatch, but nobody is told.
ALARM_EMAIL=

# ============================================
# PROMPT ENHANCEMENT MODEL (Text/Chat Model)
# ============================================
PROMPT_MODEL_PROVIDER=openai
PROMPT_MODEL_ID=gpt-4o
PROMPT_MODEL_API_KEY=sk-your-openai-key

# ============================================
# 4 FIXED IMAGE GENERATION MODELS
# ============================================

# Gemini (Google)
GEMINI_ENABLED=true
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL_ID=            # leave unset to use the template default

# Nova Canvas (AWS Bedrock) -- no API key, uses the Lambda execution role
NOVA_ENABLED=true
# NOVA_MODEL_ID=

# OpenAI (DALL-E 3)
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL_ID=

# Adobe Firefly (OAuth2 client credentials)
FIREFLY_ENABLED=true
FIREFLY_CLIENT_ID=your-firefly-client-id
FIREFLY_CLIENT_SECRET=your-firefly-client-secret
# FIREFLY_MODEL_ID=
