# ==============================================================================
# Pixel Prompt v2 — Backend Environment Variables
#
# Every variable below is read by backend/src/config.py, except the two under
# "Deploy script" which are read by backend/scripts/deploy.js. Defaults shown
# are the code's own defaults; variables with no default are marked REQUIRED.
#
# How these reach a deployed Lambda:
#   - `npm run deploy` reads .env.deploy and forwards only a SUBSET as SAM
#     parameter overrides: AUTH_ENABLED, the prompt-model trio, the four
#     models' enable/id/credential vars, ALARM_EMAIL,
#     MONTHLY_SPEND_CEILING_USD_MICROS and GLOBAL_DAILY_SPEND_CEILING_USD_MICROS
#     (backend/scripts/deploy.js buildParameterOverrides). Copy
#     .env.deploy.example to .env.deploy for that -- it is exactly that subset.
#     This file is the reference surface, not the deploy input.
#   - Everything else that IS a SAM parameter is set with
#     `sam deploy --guided` or `sam deploy --parameter-overrides Key=Value`.
#   - Seventeen variables are neither SAM parameters nor Lambda environment
#     variables in template.yaml -- the twelve COST_* entries plus
#     COST_ENHANCE_USD_MICROS, API_CLIENT_TIMEOUT, IMAGE_DOWNLOAD_TIMEOUT,
#     ENHANCE_TIMEOUT and GENERATE_THREAD_WORKERS. A deployed stack always
#     gets their defaults. They are honoured by `sam local`, the test suites
#     and a direct Lambda console edit.
# ==============================================================================

# ── AWS Configuration ─────────────────────────────────────────────────────────
AWS_REGION=us-west-2                     # AWS region for S3/CloudFront/Bedrock
S3_BUCKET=                               # REQUIRED: S3 bucket for sessions and gallery
CLOUDFRONT_DOMAIN=                       # REQUIRED: CloudFront distribution domain for CDN URLs

# ── Deploy script (backend/scripts/deploy.js, not config.py) ─────────────────
STACK_NAME=pixel-prompt-v2               # CloudFormation stack name
ALARM_EMAIL=                             # SNS subscription for the CloudWatch alarms; unset means alarms fire but deliver nowhere

# ── Gemini (Google) ───────────────────────────────────────────────────────────
GEMINI_ENABLED=true                      # Enable Gemini model
GEMINI_API_KEY=                          # Google Gemini API key
GEMINI_MODEL_ID=gemini-3.1-flash-image-preview  # Gemini image model

# ── Nova Canvas (Amazon Bedrock) ──────────────────────────────────────────────
# Auth uses the Lambda execution role's bedrock:InvokeModel permission.
# No API key is required.
NOVA_ENABLED=true                        # Enable Amazon Nova Canvas model
NOVA_MODEL_ID=amazon.nova-canvas-v1:0    # Bedrock model identifier

# ── OpenAI (DALL-E 3) ─────────────────────────────────────────────────────────
# DALL-E 3 is used for generation. Iteration/outpaint operations use
# gpt-image-1 internally because DALL-E 3 does not support images.edit.
OPENAI_ENABLED=true                      # Enable OpenAI model
OPENAI_API_KEY=                          # OpenAI API key
OPENAI_MODEL_ID=dall-e-3                 # OpenAI image generation model

# ── Adobe Firefly ─────────────────────────────────────────────────────────────
# Auth uses OAuth2 client credentials (no static API key).
FIREFLY_ENABLED=true                     # Enable Adobe Firefly model
FIREFLY_CLIENT_ID=                       # Firefly OAuth2 client ID
FIREFLY_CLIENT_SECRET=                   # Firefly OAuth2 client secret
FIREFLY_MODEL_ID=firefly-image-5         # Firefly model identifier

# ── Prompt Enhancement ────────────────────────────────────────────────────────
PROMPT_MODEL_PROVIDER=openai             # Provider for prompt enhancement (openai or google_gemini)
PROMPT_MODEL_ID=gpt-4o                   # Model ID for prompt enhancement
PROMPT_MODEL_API_KEY=                    # API key for prompt enhancement model

# ── Tier system ───────────────────────────────────────────────────────────────
# Feature flags
# REQUIRED, no default. 'true' or 'false'.
# There is no safe value to assume: 'false' serves unauthenticated
# traffic, 'true' requires Cognito + GUEST_TOKEN_SECRET. Gates identity
# only -- quota, cost caps and spend metering apply either way.
AUTH_ENABLED=false                       # Enable Cognito auth + tier resolution
BILLING_ENABLED=false                    # Enable Stripe billing (requires AUTH_ENABLED=true)

# Cognito
COGNITO_USER_POOL_ID=                    # Cognito User Pool ID
COGNITO_USER_POOL_CLIENT_ID=             # Cognito App Client ID
COGNITO_DOMAIN=                          # Cognito Hosted UI domain prefix
COGNITO_REGION=us-west-2                 # Cognito region

# DynamoDB
USERS_TABLE_NAME=pixel-prompt-users      # DynamoDB table for tier and quota state

# Guest tracking
GUEST_TOKEN_SECRET=                      # HMAC secret for signing guest cookies (REQUIRED when AUTH_ENABLED=true)
GUEST_GENERATE_LIMIT=1                   # /generate calls per guest per window
GUEST_WINDOW_SECONDS=3600                # Guest rolling window length (seconds)
# Per-IP guest bucket. A guest identity is a cookie, and dropping it mints a
# fresh one with a fresh counter; this is the bucket a cookie drop cannot
# escape. Keep it BELOW GUEST_GLOBAL_LIMIT or it can never bind first.
GUEST_IP_GENERATE_LIMIT=3                # Guest generates per source IP per window
GUEST_IP_WINDOW_SECONDS=3600             # Per-IP guest window length (seconds)
GUEST_GLOBAL_LIMIT=5                     # Global cap on guest /generate calls per window
GUEST_GLOBAL_WINDOW_SECONDS=3600         # Global guest window length (seconds)

# Anonymous tier: what an unauthenticated caller gets when AUTH_ENABLED=false.
# Open-source mode is metered, not unlimited -- these are the three variables
# that meter it, keyed on a hash of the source IP because with auth off there
# is no account to bind to.
ANON_GENERATE_LIMIT=5                    # /generate calls per source IP per window
ANON_REFINE_LIMIT=10                     # /iterate + /outpaint calls per source IP per window
ANON_WINDOW_SECONDS=3600                 # Anonymous rolling window length (seconds)

# Per-IP bounds for the two public endpoints that skip tier quota entirely.
# Both already had a GLOBAL bound (the /enhance daily spend sub-ceiling, API
# Gateway throttling), and a global bound caps everyone together -- so it
# cannot stop one caller consuming the share of all the others. Exhausting the
# enhance allocation 503s every legitimate enhance request until reset, which
# turns a cost guard into a denial-of-service amplifier.
ENHANCE_IP_LIMIT=10                      # /enhance calls per source IP per window (0 disables)
ENHANCE_IP_WINDOW_SECONDS=3600           # /enhance per-IP rolling window (seconds, must be > 0)
LOG_IP_LIMIT=120                         # /log calls per source IP per window (0 disables)
LOG_IP_WINDOW_SECONDS=3600               # /log per-IP rolling window (seconds, must be > 0)

# Free tier
FREE_GENERATE_LIMIT=1                    # /generate calls per free user per window
FREE_REFINE_LIMIT=2                      # /iterate + /outpaint calls per free user per window
FREE_WINDOW_SECONDS=3600                 # Free tier rolling window length (seconds)

# Paid tier
PAID_DAILY_LIMIT=200                     # Refinement calls per paid user per day (operator-tuned)
PAID_DAILY_GENERATE_LIMIT=50             # Generate calls per paid user per day (~$9.50/day)
PAID_WINDOW_SECONDS=86400                # Paid tier rolling window length (seconds)

# Stripe
STRIPE_SECRET_KEY=                       # Stripe API secret key (REQUIRED when BILLING_ENABLED=true)
STRIPE_WEBHOOK_SECRET=                   # Stripe webhook signing secret (REQUIRED when BILLING_ENABLED=true)
STRIPE_PRICE_ID=                         # Stripe price ID for paid subscription
STRIPE_SUCCESS_URL=                      # Redirect URL after successful checkout
STRIPE_CANCEL_URL=                       # Redirect URL after cancelled checkout
STRIPE_PORTAL_RETURN_URL=                # Return URL from Stripe customer portal

# How long a Stripe call may hold a Lambda execution. The SDK default is an
# 80-second timeout with 2 retries, which behind the 29s gateway ceiling means
# an unbounded call outlives the request it serves -- and GET /pricing is
# public and hit on every page load, so a slow Stripe is amplified by ordinary
# traffic into the execution pool the paid endpoints share.
STRIPE_TIMEOUT_SECONDS=5.0               # Per-ATTEMPT Stripe budget, connect+read (seconds, must be > 0)
STRIPE_MAX_NETWORK_RETRIES=1             # Stripe retry budget (multiplies with the timeout)

# ── Credit ledger ─────────────────────────────────────────────────────────────
# Off by default; the call-counting quotas above stay in force while it is off.
# Credits are integer CENTI-credits (1 credit = 100) so a refine costing a
# quarter of a generate never needs a float in a DynamoDB counter.
#
# WARNING: with CREDITS_ENABLED=true, the seven values below RAISE AT IMPORT
# if set to zero or a negative number (config.py _require_positive). That is a
# Lambda cold-start failure with no request attached to it -- look in the
# function's init logs, not at an API response.
CREDITS_ENABLED=false                    # Master switch for the credit ledger
CREDITS_PER_GENERATE=100                 # Centi-credits per /generate (1.00 credit)
CREDITS_PER_REFINE=25                    # Centi-credits per /iterate (0.25 credit)
CREDITS_PER_OUTPAINT=25                  # Centi-credits per /outpaint (0.25 credit)
FREE_MONTHLY_CREDITS=500                 # Free tier allotment per period (5 credits)
PAID_MONTHLY_CREDITS=6500                # Paid tier allotment per period (65 credits)
FREE_CREDIT_PERIOD_SECONDS=2592000       # Free tier renewal window (30d); paid tiers renew on Stripe's period boundaries
PAID_CREDIT_FALLBACK_PERIOD_SECONDS=2592000  # Renewal floor for a paid user whose Stripe period is unknown
PAID_PRICE_USD_CENTS=1900                # Display price served by GET /pricing ($19/mo)
OVERAGE_USD_CENTS_PER_CREDIT=50          # Display overage price served by GET /pricing

# ── Spend ceilings (micro-dollars, 1e-6 USD) ─────────────────────────────────
# Both apply unconditionally, regardless of AUTH_ENABLED: the provider bills
# for a generation whether or not the caller signed in. Set to 0 to disable,
# consciously.
GLOBAL_DAILY_SPEND_CEILING_USD_MICROS=25000000   # $25/day. Burst headroom under the monthly bound
MONTHLY_SPEND_CEILING_USD_MICROS=500000000       # $500/month. The bound that caps the invoice
ENHANCE_DAILY_SPEND_CEILING_USD_MICROS=2000000   # $2/day sub-ceiling for /enhance, which is unauthenticated

# ── Provider cost table (micro-dollars per call) ─────────────────────────────
# What a provider call costs US. Integers, because these feed DynamoDB atomic
# counters and float accumulation would drift. The twelve per-model names are
# CONSTRUCTED DYNAMICALLY in config.py, so grepping the source for them finds
# nothing -- this file and CLAUDE.md are the only places they are written out.
#
# Seeded from public rate cards. Replace with measured spend before committing
# to any public price. Not SAM parameters: see the header.
COST_GEMINI_GENERATE_USD_MICROS=39000    # $0.039
COST_GEMINI_REFINE_USD_MICROS=39000
COST_GEMINI_OUTPAINT_USD_MICROS=39000
COST_NOVA_GENERATE_USD_MICROS=40000      # $0.040
COST_NOVA_REFINE_USD_MICROS=40000
COST_NOVA_OUTPAINT_USD_MICROS=40000
COST_OPENAI_GENERATE_USD_MICROS=40000    # $0.040
COST_OPENAI_REFINE_USD_MICROS=40000
COST_OPENAI_OUTPAINT_USD_MICROS=40000
COST_FIREFLY_GENERATE_USD_MICROS=70000   # $0.070 (credit-based; least certain of the four)
COST_FIREFLY_REFINE_USD_MICROS=70000
COST_FIREFLY_OUTPAINT_USD_MICROS=70000
COST_ENHANCE_USD_MICROS=7000             # One gpt-4o prompt adaptation, charged per /generate and per /enhance

# ── Per-Model Daily Caps ──────────────────────────────────────────────────────
MODEL_GEMINI_DAILY_CAP=500               # Daily generation cap for Gemini
MODEL_NOVA_DAILY_CAP=500                 # Daily generation cap for Nova Canvas
MODEL_OPENAI_DAILY_CAP=500               # Daily generation cap for OpenAI
MODEL_FIREFLY_DAILY_CAP=500              # Daily generation cap for Firefly

# ── Spend-guard degradation ───────────────────────────────────────────────────
# Every ceiling above reads one DynamoDB table and every guard over it fails
# OPEN, so one partition opens all of them and stops the accounting too. These
# two are the bound that needs no table: per-container state in a warm Lambda
# execution environment (backend/src/ops/store_breaker.py). Per container, not
# fleet-wide.
STORE_FAILURE_THRESHOLD=5                # Consecutive store failures before this container's breaker trips
DEGRADED_DISPATCH_BUDGET=20              # Generations a tripped container may still dispatch before /generate sheds with 503

# ── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────────
CAPTCHA_ENABLED=false                    # Enable Turnstile CAPTCHA for guest /generate
TURNSTILE_SECRET_KEY=                    # Cloudflare Turnstile secret key (REQUIRED when CAPTCHA_ENABLED=true)

# ── Age gate ─────────────────────────────────────────────────────────────────
# Defaults to true. Google's API terms allow use only where the service is not
# "likely to be accessed by" under-18s, so leave this on unless you meet that
# requirement another way.
AGE_GATE_ENABLED=true                    # Require an 18+ confirmation before first /generate

# ── Email Notifications (Amazon SES) ─────────────────────────────────────────
SES_ENABLED=false                        # Enable SES email notifications
SES_FROM_EMAIL=                          # Verified SES sender email address (REQUIRED when SES_ENABLED=true)
SES_REGION=us-west-2                     # AWS region for SES

# ── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_ENABLED=false                      # Enable admin API endpoints (requires AUTH_ENABLED=true)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=*                    # Allowed CORS origin (set to frontend domain in production)

# ── Dispatch and operational timeouts ────────────────────────────────────────
# GENERATE_ASYNC=true means POST /generate answers as soon as the session
# exists and hands provider work to an asynchronous self-invocation. Set false
# and the handler runs the generation inline and returns the full result --
# the only mode that works where there is no Lambda service to invoke, i.e.
# `sam local start-api` and the MiniStack E2E suite.
GENERATE_ASYNC=true                      # Asynchronous /generate dispatch

# NOT a free-standing knob: generate_dispatch_budget_seconds is
# API_CLIENT_TIMEOUT + 10, so raising this raises the worker's dispatch budget
# with it. It read 120.0 here against a code default of 60.0, which silently
# doubled the budget for anyone who copied this file.
API_CLIENT_TIMEOUT=60.0                  # Timeout for AI provider API calls (seconds)
IMAGE_DOWNLOAD_TIMEOUT=30                # Timeout for downloading generated images (seconds)
# Clamped to sync_dispatch_budget_seconds (25.0) whatever you set here: a 30s
# enhance behind a 29s API Gateway ceiling cannot succeed at its limit, and
# the LLM call is billed anyway.
ENHANCE_TIMEOUT=30.0                     # Timeout for prompt enhancement/adaptation LLM calls (seconds)
GENERATE_THREAD_WORKERS=4                # Number of parallel generation threads
